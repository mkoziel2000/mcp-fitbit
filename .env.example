GOOGLE_HEALTH_CLIENT_ID=your_client_id
GOOGLE_HEALTH_CLIENT_SECRET=your_client_secret

# Optional: Fitbit-compatible output mode (legacy Fitbit tool names, parameters, shapes and units)
# GOOGLE_HEALTH_OUTPUT_MODE=fitbit
# Optional IANA time zone override (defaults to the Google Health account setting)
# COMPAT_TIME_ZONE=America/Denver
